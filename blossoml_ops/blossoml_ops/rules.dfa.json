  {
   "id": "R1",
   "name": "再起動の前に状態とログを確認する",
   "description": "restart_service を呼ぶ前に、service_status と read_logs を実行してください。",
   "formula": "(!restart W status_checked) & (!restart W logs_read)",
   "on_violation": "deny",
   "alert": null,
   "aps": [
    "logs_read",
    "restart",
    "status_checked"
   ],
   "initial": 0,
   "states": [
    {
     "id": 0,
     "accepting": true,
     "dead": false,
     "permanent": false,
     "safe_next": "!restart | (logs_read & status_checked)",
     "transitions": [
      {
       "guard": "!logs_read & !restart & !status_checked",
       "to": 0
      },
      {
       "guard": "logs_read & !restart & !status_checked",
       "to": 1
      },
      {
       "guard": "!logs_read & !restart & status_checked",
       "to": 2
      },
      {
       "guard": "logs_read & status_checked",
       "to": 3
      },
      {
       "guard": "(restart & !status_checked) | (!logs_read & restart)",
       "to": 4
      }
     ]
    },
    {
     "id": 1,
     "accepting": true,
     "dead": false,
     "permanent": false,
     "safe_next": "!restart | status_checked",
     "transitions": [
      {
       "guard": "!restart & !status_checked",
       "to": 1
      },
      {
       "guard": "status_checked",
       "to": 3
      },
      {
       "guard": "restart & !status_checked",
       "to": 4
      }
     ]
    },
    {
     "id": 2,
     "accepting": true,
     "dead": false,
     "permanent": false,
     "safe_next": "logs_read | !restart",
     "transitions": [
      {
       "guard": "!logs_read & !restart",
       "to": 2
      },
      {
       "guard": "logs_read",
       "to": 3
      },
      {
       "guard": "!logs_read & restart",
       "to": 4
      }
     ]
    },
    {
     "id": 3,
     "accepting": true,
     "dead": false,
     "permanent": true,
     "safe_next": "true",
     "transitions": [
      {
       "guard": "true",
       "to": 3
      }
     ]
    },
    {
     "id": 4,
     "accepting": false,
     "dead": true,
     "permanent": false,
     "safe_next": "false",
     "transitions": [
      {
       "guard": "true",
       "to": 4
      }
     ]
    }
   ]
  },
  {
   "id": "R2",
   "name": "再起動は 1 セッション 1 回まで",
   "description": "restart_service は 1 セッションに 1 回までです。2 回目が必要な状況なら critical で運営者に報告してください。",
   "formula": "G((restart) -> X(G!(restart)))",
   "on_violation": "deny",
   "alert": null,
   "aps": [
    "restart"
   ],
   "initial": 0,
   "states": [
    {
     "id": 0,
     "accepting": true,
     "dead": false,
     "permanent": false,
     "safe_next": "true",
     "transitions": [
      {
       "guard": "!restart",
       "to": 0
      },
      {
       "guard": "restart",
       "to": 1
      }
     ]
    },
    {
     "id": 1,
     "accepting": true,
     "dead": false,
     "permanent": false,
     "safe_next": "!restart",
     "transitions": [
      {
       "guard": "!restart",
       "to": 1
      },
      {
       "guard": "restart",
       "to": 2
      }
     ]
    },
    {
     "id": 2,
     "accepting": false,
     "dead": true,
     "permanent": false,
     "safe_next": "false",
     "transitions": [
      {
       "guard": "true",
       "to": 2
      }
     ]
    }
   ]
  },
  {
   "id": "R4",
   "name": "再起動後は稼働確認する",
   "description": "restart_service の後に http_probe（target=root_get）で HTTP 200 を確認してください。",
   "formula": "G((restart) -> F(probe_ok))",
   "on_violation": "deny",
   "alert": null,
   "aps": [
    "probe_ok",
    "restart"
   ],
   "initial": 0,
   "states": [
    {
     "id": 0,
     "accepting": true,
     "dead": false,
     "permanent": false,
     "safe_next": "true",
     "transitions": [
      {
       "guard": "probe_ok | !restart",
       "to": 0
      },
      {
       "guard": "!probe_ok & restart",
       "to": 1
      }
     ]
    },
    {
     "id": 1,
     "accepting": false,
     "dead": false,
     "permanent": false,
     "safe_next": "true",
     "transitions": [
      {
       "guard": "probe_ok",
       "to": 0
      },
      {
       "guard": "!probe_ok",
       "to": 1
      }
     ]
    }
   ]
  },
  {
   "id": "R5",
   "name": "tmp 掃除の前に DB をバックアップする",
   "description": "cleanup_tmp を呼ぶ前に、backup_db を実行して成功させてください。",
   "formula": "!(cleanup) W (backup_ok)",
   "on_violation": "deny",
   "alert": null,
   "aps": [
    "backup_ok",
    "cleanup"
   ],
   "initial": 0,
   "states": [
    {
     "id": 0,
     "accepting": true,
     "dead": false,
     "permanent": false,
     "safe_next": "backup_ok | !cleanup",
     "transitions": [
      {
       "guard": "!backup_ok & !cleanup",
       "to": 0
      },
      {
       "guard": "backup_ok",
       "to": 1
      },
      {
       "guard": "!backup_ok & cleanup",
       "to": 2
      }
     ]
    },
    {
     "id": 1,
     "accepting": true,
     "dead": false,
     "permanent": true,
     "safe_next": "true",
     "transitions": [
      {
       "guard": "true",
       "to": 1
      }
     ]
    },
    {
     "id": 2,
     "accepting": false,
     "dead": true,
     "permanent": false,
     "safe_next": "false",
     "transitions": [
      {
       "guard": "true",
       "to": 2
      }
     ]
    }
   ]
  }
 ]
