 "spot_version": "2.16",
 "rules": [
  {
   "id": "R0",
   "name": "許可リストのツールしか呼ばない",
   "description": "このエージェントに登録されたツール以外は使えません。",
   "formula": "G(allowed_tool)",
   "on_violation": "deny",
   "alert": "critical",
   "aps": [
    "allowed_tool"
   ],
   "initial": 0,
   "states": [
    {
     "id": 0,
     "accepting": true,
     "dead": false,
     "permanent": false,
     "safe_next": "allowed_tool",
     "transitions": [
      {
       "guard": "allowed_tool",
       "to": 0
      },
      {
       "guard": "!allowed_tool",
       "to": 1
      }
     ]
    },
    {
     "id": 1,
     "accepting": false,
     "dead": true,
     "permanent": false,
     "safe_next": "false",
     "transitions": [
      {
       "guard": "true",
       "to": 1
      }
     ]
    }
   ]
  },
  {
   "id": "R6",
   "name": "probe は許可リストの対象のみ",
   "description": "http_probe の target は root_get / upload_head / test_blob_head / test_blob_get のいずれかに限られます。",
   "formula": "G!(probe_non_allowlisted)",
   "on_violation": "deny",
   "alert": "critical",
   "aps": [
    "probe_non_allowlisted"
   ],
   "initial": 0,
   "states": [
    {
     "id": 0,
     "accepting": true,
     "dead": false,
     "permanent": false,
     "safe_next": "!probe_non_allowlisted",
     "transitions": [
      {
       "guard": "!probe_non_allowlisted",
       "to": 0
      },
      {
       "guard": "probe_non_allowlisted",
       "to": 1
      }
     ]
    },
    {
     "id": 1,
     "accepting": false,
     "dead": true,
     "permanent": false,
     "safe_next": "false",
     "transitions": [
      {
       "guard": "true",
       "to": 1
      }
     ]
    }
   ]
  },
  {
   "id": "R5'",
   "name": "終了前に必ず報告する",
   "description": "終了する前に notify で運営者に報告を送り、1 つ以上のリレーに受理されている必要があります。",
   "formula": "F(notified)",
   "on_violation": "deny",
   "alert": null,
   "aps": [
    "notified"
   ],
   "initial": 0,
   "states": [
    {
     "id": 0,
     "accepting": false,
     "dead": false,
     "permanent": false,
     "safe_next": "true",
     "transitions": [
      {
       "guard": "!notified",
       "to": 0
      },
      {
       "guard": "notified",
       "to": 1
      }
     ]
    },
    {
     "id": 1,
     "accepting": true,
     "dead": false,
     "permanent": true,
     "safe_next": "true",
     "transitions": [
      {
       "guard": "true",
       "to": 1
      }
     ]
    }
   ]
  },
  {
   "id": "R8",
   "name": "info 通知は 1 回まで",
   "description": "info の通知はセッションあたり 1 通までです。内容をまとめて 1 通で送ってください。",
   "formula": "G((notify_info) -> X(G!(notify_info)))",
   "on_violation": "deny",
   "alert": null,
   "aps": [
    "notify_info"
   ],
   "initial": 0,
   "states": [
    {
     "id": 0,
     "accepting": true,
     "dead": false,
     "permanent": false,
     "safe_next": "true",
     "transitions": [
      {
       "guard": "!notify_info",
       "to": 0
      },
      {
       "guard": "notify_info",
       "to": 1
      }
     ]
    },
    {
     "id": 1,
     "accepting": true,
     "dead": false,
     "permanent": false,
     "safe_next": "!notify_info",
     "transitions": [
      {
       "guard": "!notify_info",
       "to": 1
      },
      {
       "guard": "notify_info",
       "to": 2
      }
     ]
    },
    {
     "id": 2,
     "accepting": false,
     "dead": true,
     "permanent": false,
     "safe_next": "false",
     "transitions": [
      {
       "guard": "true",
       "to": 2
      }
     ]
    }
   ]
  },
  {
   "id": "R9",
   "name": "warning / critical 通知は合計 5 回まで",
   "description": "warning と critical の通知は合わせて 5 通までです。",
   "formula": "G((notify_alert) -> X(G((notify_alert) -> X(G((notify_alert) -> X(G((notify_alert) -> X(G((notify_alert) -> X(G!(notify_alert)))))))))))",
   "on_violation": "deny",
   "alert": null,
