#!/usr/bin/python3 -I
"""Root-owned (phase 2). Delete data/tmp_* older than N hours (6..168).

Installed at /usr/local/libexec/blossoml-ops/cleanup-tmp, owner root, mode 0755.
Only regular files whose name is exactly tmp_<digits>_<digits> are removed;
symlinks are never followed.
"""
import os
import re
import stat
import sys
import time

DATA = "/home/ubuntu/blossoML/data"
NAME = re.compile(r"^tmp_\d{1,10}_\d{1,10}$")

if len(sys.argv) != 2 or not re.fullmatch(r"\d{1,3}", sys.argv[1]):
    print("usage: cleanup-tmp <hours 6..168>", file=sys.stderr)
    sys.exit(2)
hours = int(sys.argv[1])
if not 6 <= hours <= 168:
    print("hours must be in 6..168", file=sys.stderr)
    sys.exit(2)
cutoff = time.time() - hours * 3600
removed = kept = freed = 0
dfd = os.open(DATA, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    for name in os.listdir(dfd):
        if not NAME.match(name):
            continue
        st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
        if not stat.S_ISREG(st.st_mode) or st.st_mtime > cutoff:
            kept += 1
            continue
        os.unlink(name, dir_fd=dfd)
        removed += 1
        freed += st.st_size
finally:
    os.close(dfd)
print(f"removed={removed} kept={kept} freed_bytes={freed}")
